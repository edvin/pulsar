{
  "name": "pulsar",
  "private": true,
  "type": "module",
  "description": "Beautiful status pages on Cloudflare Workers and D1, with a v2-compatible read API.",
  "license": "MIT",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate": "wrangler d1 migrations apply pulsar --remote",
    "migrate:local": "wrangler d1 migrations apply pulsar --local",
    "add-user": "node scripts/add-user.mjs",
    "demo": "node scripts/demo.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.0.0"
  }
}
